# Local synthetic scaffold only; create this database before running migrations.
# Copy to .env in the repository root. Use a local password, never commit it.
DATABASE_URL=postgresql+psycopg://doccheck:CHANGE_ME@127.0.0.1:5432/doccheck
WORKER_POLL_SECONDS=0.5
SYNTHETIC_DELAY_SECONDS=2

# Docker Compose: set a separate random password made of URL-safe characters (e.g. hex).
DOCCHECK_DB_PASSWORD=
DOCCHECK_PORT=8080
