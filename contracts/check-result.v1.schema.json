          "$ref": "#/$defs/CheckResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/Issue"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "run_id",
    "status",
    "result",
    "error"
  ],
  "title": "CheckJob",
  "type": "object"
