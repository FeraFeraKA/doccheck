{
  "$defs": {
    "Calculation": {
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "operation": {
          "anyOf": [
            {
              "const": "sum",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation"
        },
        "formula": {
          "minLength": 1,
          "title": "Formula",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "title": "Components",
          "type": "array"
        }
      },
      "required": [
        "policy_id",
        "formula",
        "components"
      ],
      "title": "Calculation",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "if": {
        "properties": {
          "synthetic": {
            "const": false
          }
        }
      },
      "properties": {
        "schema_version": {
          "const": "doccheck-check-result/1",
          "title": "Schema Version",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        },
        "report_number": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Number"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "versions": {
          "$ref": "#/$defs/Versions"
        },
        "documents": {
          "items": {
            "$ref": "#/$defs/SourceDocument"
          },
          "title": "Documents",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/ResultRow"
          },
          "title": "Rows",
          "type": "array"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "synthetic",
        "scope",
        "versions",
        "documents",
        "evidence",
        "rows",
        "summary"
      ],
      "then": {
        "properties": {
          "rows": {
            "items": {
              "properties": {
                "completeness": {
                  "properties": {
                    "basis": {
                      "not": {
                        "const": "dataset_fixture"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "title": "CheckResult",
      "type": "object"
    },
    "Completeness": {
      "additionalProperties": false,
      "if": {
        "properties": {
          "basis": {
            "const": "none"
          }
        }
      },
      "properties": {
        "state": {
          "enum": [
            "complete",
            "incomplete",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        },
        "basis": {
          "enum": [
            "manifest",
            "user_declaration",
            "dataset_fixture",
            "none"
          ],
          "title": "Basis",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "state",
        "basis",
        "reason",
        "evidence_refs"
      ],
      "then": {
        "properties": {
          "state": {
            "const": "unknown"
          }
        }
      },
      "title": "Completeness",
      "type": "object"
    },
    "Component": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?(?![\\s\\S])",
          "title": "Amount",
          "type": "string"
        },
        "amount_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Amount Refs",
          "type": "array"
        },
        "contract_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Contract Refs",
          "type": "array"
        },
        "period_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Period Refs",
          "type": "array"
        },
        "article_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Article Refs",
          "type": "array"
        },
        "identity_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Identity Refs",
          "type": "array"
        },
        "relation_reason": {
          "minLength": 1,
          "title": "Relation Reason",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "amount_refs",
        "contract_refs",
        "period_refs",
        "article_refs",
        "relation_reason"
      ],
      "title": "Component",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "normalized_value": {
                "type": "string"
              }
            }
          },
          "if": {
            "properties": {
              "kind": {
                "const": "period"
              }
            }
          },
          "then": {
            "properties": {
              "normalized_value": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "amount",
                  "reported_value"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "normalized_value": {
                "pattern": "^-?[0-9]+(?:\\.[0-9]+)?(?![\\s\\S])"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "amount",
                  "reported_value"
                ]
              },
              "unit": {
                "const": "RUB"
              }
            }
          },
          "then": {
            "properties": {
              "normalized_value": {
                "pattern": "^(?!-0+\\.00(?![\\s\\S]))-?[0-9]+\\.[0-9]{2}(?![\\s\\S])",
                "type": "string"
              }
            }
          }
        }
      ],
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "reported_value",
            "amount",
            "contract",
            "period",
            "article",
            "document_identity"
          ],
          "title": "Kind",
          "type": "string"
        },
        "raw_value": {
          "minLength": 1,
          "title": "Raw Value",
          "type": "string"
        },
        "normalized_value": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "$ref": "#/$defs/Period"
            }
          ],
          "title": "Normalized Value"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "page": "#/$defs/PageLocator",
              "paragraph": "#/$defs/ParagraphLocator",
              "sheet": "#/$defs/SheetLocator",
              "table_cell": "#/$defs/TableCellLocator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PageLocator"
            },
            {
              "$ref": "#/$defs/SheetLocator"
            },
            {
              "$ref": "#/$defs/ParagraphLocator"
            },
            {
              "$ref": "#/$defs/TableCellLocator"
            }
          ],
          "title": "Locator"
        }
      },
      "required": [
        "id",
        "document_id",
        "kind",
        "raw_value",
        "normalized_value",
        "unit",
        "method",
        "locator"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FileDecision": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "include",
            "exclude",
            "needs_review",
            "parse_error"
          ],
          "title": "State",
          "type": "string"
        },
        "reason_code": {
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "state",
        "reason_code",
        "message",
        "evidence_refs"
      ],
      "title": "FileDecision",
      "type": "object"
    },
    "FileError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "id"
      ],
      "title": "FileError",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "PageLocator": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "table_row": {
                "type": "integer"
              }
            },
            "required": [
              "table_row"
            ]
          },
          "then": {
            "properties": {
              "table_column": {
                "type": "integer"
              }
            },
            "required": [
              "table_column"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "table_column": {
                "type": "integer"
              }
            },
            "required": [
              "table_column"
            ]
          },
          "then": {
            "properties": {
              "table_row": {
                "type": "integer"
              }
            },
            "required": [
              "table_row"
            ]
          }
        }
      ],
      "anyOf": [
        {
          "properties": {
            "bbox": {
              "type": "array"
            }
          },
          "required": [
            "bbox"
          ]
        },
        {
          "properties": {
            "line": {
              "type": "integer"
            }
          },
          "required": [
            "line"
          ]
        },
        {
          "properties": {
            "table_row": {
              "type": "integer"
            },
            "table_column": {
              "type": "integer"
            }
          },
          "required": [
            "table_row",
            "table_column"
          ]
        },
        {
          "properties": {
            "fragment_id": {
              "type": "string"
            }
          },
          "required": [
            "fragment_id"
          ]
        }
      ],
      "properties": {
        "kind": {
          "const": "page",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "table_row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Row"
        },
        "table_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Column"
        },
        "fragment_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fragment Id"
        }
      },
      "required": [
        "kind",
        "page"
      ],
      "title": "PageLocator",
      "type": "object"
    },
    "ParagraphLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "paragraph",
          "title": "Kind",
          "type": "string"
        },
        "paragraph": {
          "minimum": 1,
          "title": "Paragraph",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "paragraph"
      ],
      "title": "ParagraphLocator",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "start": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "end": {
              "type": "string"
            }
          }
        }
      ],
      "properties": {
        "start": {
          "anyOf": [
            {
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "End"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Period",
      "type": "object"
    },
    "PrimaryIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "file_error_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "File Error Refs",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message",
        "evidence_refs",
        "id"
      ],
      "title": "PrimaryIssue",
      "type": "object"
    },
    "Reason": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message",
        "evidence_refs"
      ],
      "title": "Reason",
      "type": "object"
    },
    "ResultRow": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "unit": {
                "const": "RUB"
              }
            }
          },
          "then": {
            "properties": {
              "reported_value": {
                "anyOf": [
                  {
                    "pattern": "^(?!-0+\\.00(?![\\s\\S]))-?[0-9]+\\.[0-9]{2}(?![\\s\\S])",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "expected_value": {
                "anyOf": [
                  {
                    "pattern": "^(?!-0+\\.00(?![\\s\\S]))-?[0-9]+\\.[0-9]{2}(?![\\s\\S])",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "observed_evidence_sum": {
                "anyOf": [
                  {
                    "pattern": "^(?!-0+\\.00(?![\\s\\S]))-?[0-9]+\\.[0-9]{2}(?![\\s\\S])",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "delta": {
                "anyOf": [
                  {
                    "pattern": "^(?!-0+\\.00(?![\\s\\S]))-?[0-9]+\\.[0-9]{2}(?![\\s\\S])",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "calculation": {
                "properties": {
                  "components": {
                    "items": {
                      "properties": {
                        "amount": {
                          "pattern": "^(?!-0+\\.00(?![\\s\\S]))-?[0-9]+\\.[0-9]{2}(?![\\s\\S])",
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "reported_value": {
                "type": "string"
              },
              "expected_value": {
                "type": "string"
              },
              "delta": {
                "type": "string"
              }
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "unverified"
              }
            }
          },
          "then": {
            "properties": {
              "delta": {
                "type": "null"
              },
              "reasons": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "discrepancy"
              }
            }
          },
          "then": {
            "properties": {
              "reasons": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reported_value": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "reported_evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "observed_evidence_sum": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "calculation": {
                "properties": {
                  "components": {
                    "minItems": 1
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "observed_evidence_sum": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "completeness": {
                "properties": {
                  "state": {
                    "enum": [
                      "unknown",
                      "incomplete"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "expected_value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expected_value": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "calculation": {
                "properties": {
                  "operation": {
                    "const": "sum"
                  },
                  "components": {
                    "minItems": 1
                  }
                },
                "required": [
                  "operation"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "derived_mismatch": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "discrepancy"
              },
              "root_issue_id": {
                "type": "string"
              }
            }
          }
        }
      ],
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "indicator_code": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Indicator Code"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "reported_value": {
          "anyOf": [
            {
              "pattern": "^-?[0-9]+(?:\\.[0-9]+)?(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reported Value"
        },
        "reported_evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reported Evidence Refs",
          "type": "array"
        },
        "expected_value": {
          "anyOf": [
            {
