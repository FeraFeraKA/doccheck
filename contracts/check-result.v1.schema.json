                  "error"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "errors": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "properties": {
                  "state": {
                    "const": "parse_error"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "parse_status": {
                "const": "error"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "properties": {
                  "state": {
                    "const": "include"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "parse_status": {
                "enum": [
                  "parsed",
                  "partial"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "duplicate_of": {
                "type": "string"
              }
            },
            "required": [
              "duplicate_of"
            ]
          },
          "then": {
            "properties": {
              "decision": {
                "properties": {
                  "state": {
                    "const": "exclude"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "errors": {
                "contains": {
                  "properties": {
                    "code": {
                      "const": "unsupported_format"
                    }
                  },
                  "required": [
                    "code"
                  ]
                }
              }
            }
          }
        }
      ],
      "properties": {
