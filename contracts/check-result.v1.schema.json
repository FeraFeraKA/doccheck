  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "result": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "enum": [
              "completed",
              "completed_with_issues"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "queued",
              "processing",
              "completed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "not": {
              "properties": {
                "documents": {
                  "contains": {
                    "properties": {
                      "errors": {
                        "minItems": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed_with_issues"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "error": {
                "type": "object"
              }
            }
          },
          {
            "properties": {
              "result": {
                "properties": {
                  "documents": {
                    "contains": {
                      "properties": {
                        "errors": {
                          "minItems": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  ],
  "properties": {
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "processing",
        "completed",
        "completed_with_issues",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "result": {
      "anyOf": [
